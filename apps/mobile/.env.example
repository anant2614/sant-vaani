# Copy to .env.local. Every value is optional: without them the app opens with
# the catalogue it ships with, no sign-in and no analytics.
# Values for local development come from `supabase status`. On a phone, use
# your computer's network address instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Where the nightly catalogue is published. Defaults to the catalogue bucket
# of the Supabase project above.
EXPO_PUBLIC_CATALOGUE_URL=
# PostHog project key. Leave it empty to send no analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# The website that serves /terms and /privacy. The YouTube player also uses it
# as its origin, so YouTube can tell which app embeds the clips.
EXPO_PUBLIC_SITE_URL=
# Where shared answers link to, as <url>/a/<answer id>. Defaults to the site.
EXPO_PUBLIC_SHARE_BASE_URL=
