# Copy to .env.local. Values for local development come from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. A Google Cloud API key with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=
# Sentry DSN for crash reports from the studio's server and browsers. Leave it empty to send none.
NEXT_PUBLIC_SENTRY_DSN=
