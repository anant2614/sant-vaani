# Settings for the server functions.
# Locally: copy this file to supabase/functions/.env, then
#   npx supabase functions serve --env-file supabase/functions/.env
# In the hosted project: npx supabase secrets set NAME=value
# Supabase provides SUPABASE_URL and the secret key (SUPABASE_SECRET_KEYS) itself.

# Claude: Ask matches typed questions, and suggest-clips reads new talks overnight.
# Without a key, Ask matches on words alone and suggest-clips does not run.
ANTHROPIC_API_KEY=
# Optional: try other models without a deploy.
ASK_MODEL=claude-opus-5-5
SUGGEST_MODEL=claude-opus-5-5
# Optional: typed questions a day Ask may send to Claude, across everyone (default 3000).
# Past it, Ask matches on words until midnight India time.
ASK_DAILY_MODEL_CALLS=

# YouTube Data API v3 key, for fetch-uploads and check-clips.
YOUTUBE_API_KEY=

# The same random secret stored in Vault as cron_secret; the scheduled jobs refuse other callers.
CRON_SECRET=

# Optional: only if push security is turned on in the Expo account.
EXPO_ACCESS_TOKEN=
